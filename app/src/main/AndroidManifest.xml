<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <application
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.DailyPsalms">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:theme="@style/Theme.DailyPsalms"
            android:configChanges="orientation|screenSize|screenLayout|keyboardHidden">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <receiver
            android:name=".ui.theme.DailyPsalmsWidgetReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/daily_psalms_widget_info" />
        </receiver>

        <receiver
            android:name=".MidnightWidgetReceiver"
            android:exported="false">
            <intent-filter>
                <!-- Triggers exactly when the device date rolls over to midnight -->
                <action android:name="android.intent.action.DATE_CHANGED" />
                <!-- Triggers if the user travels to a new time zone -->
                <action android:name="android.intent.action.TIMEZONE_CHANGED" />
                <!-- Triggers if the user manually changes their phone's clock -->
                <action android:name="android.intent.action.TIME_SET" />
                <!-- Triggers when the user unlocks their phone -->
                <action android:name="android.intent.action.USER_PRESENT" />
            </intent-filter>
        </receiver>

    </application>

</manifest>
